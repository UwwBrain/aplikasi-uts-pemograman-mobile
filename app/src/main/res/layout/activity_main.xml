<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_primary"
        android:paddingVertical="16dp"
        android:paddingHorizontal="20dp"
        android:text="DAFTAR MENU AYY'S COFFEE"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:gravity="center"
        android:elevation="4dp" />

    <!-- Sub Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:text="Katalog Makanan, Minuman &amp; Dessert"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:background="#F0EBE6" />

    <!-- Form Pencarian Real-time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:hint="Cari Menu (Nama, Kategori, Harga)..."
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textColorHint="@color/text_sub"
            android:textColor="@color/text_title"
            android:background="@android:drawable/editbox_background"
            android:inputType="text" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Search Icon" />
    </LinearLayout>

    <!-- Custom ListView -->
    <ListView
        android:id="@+id/listViewMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:paddingTop="5dp"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="10dp" />

</LinearLayout>